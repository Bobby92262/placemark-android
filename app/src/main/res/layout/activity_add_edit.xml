<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/innerScrollView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp">

        <TextView
            android:id="@+id/formTitle"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="5dp"
            android:paddingTop="5dp"
            android:paddingEnd="10dp"
            android:text="Add Mark"
            android:textSize="28sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/titleInput"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_margin="5dp"
            android:hint="Title"
            android:paddingStart="5dp"
            android:paddingEnd="5dp" />

        <EditText
            android:id="@+id/descriptionInput"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_margin="5dp"
            android:hint="Description"
            android:minLines="3"
            android:paddingTop="5dp"
            android:paddingEnd="5dp" />

        <ImageView
            android:id="@+id/imagePicker"
            android:layout_width="match_parent"
            android:layout_height="138dp"
            android:scaleType="centerCrop"
            app:srcCompat="@drawable/ic_launcher_foreground" />

        <Button
            android:id="@+id/ImagePickButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="6dp"
            android:text="Button" />

        <EditText
            android:id="@+id/xInput"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_margin="6dp"
            android:hint="X Coordinate"
            android:inputType="number|numberDecimal"
            android:paddingTop="5dp"
            android:paddingEnd="5dp" />

        <EditText
            android:id="@+id/yInput"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_margin="6dp"
            android:hint="Y Coordinate"
            android:paddingTop="5dp"
            android:paddingEnd="5dp" />

        <Button
            android:id="@+id/OSMbutton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="6dp"
            android:text="Map Picker" />

        <Button
            android:id="@+id/saveButton"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="6dp"
            android:text="Save"
            android:textSize="20sp" />

        <Button
            android:id="@+id/cancelButton"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="6dp"
            android:text="Cancel"
            android:textSize="20sp" />

    </LinearLayout>
</ScrollView>